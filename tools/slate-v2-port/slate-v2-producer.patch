+// exportSigningKeys returns the two keys a witness-bundle/2 export needs: the
+// node identity key, which signs the tree head, and the exporter key, which signs
+// the header. The node key is also used as the exporter key when SLATE_SIGN_KEY
+// is unset — the format permits one key for both roles, and it never lets a
+// verifier assume they differ. The legacy v1 format is the escape hatch when no
+// node key is available.
+func exportSigningKeys(dir string) (ed25519.PrivateKey, ed25519.PrivateKey, error) {
+	nodeKey, _, err := resolveNodeKey(dir)
+	if err != nil {
+		return nil, nil, fmt.Errorf("witness-bundle/2 needs the node identity key: %w "+
+			"(run `slate init`, or export with --format=1 for legacy v1)", err)
+	}
+	if h := os.Getenv("SLATE_SIGN_KEY"); h != "" {
+		exportKey, err := slateexport.DecodePrivateKey(h)
+		if err != nil {
+			return nil, nil, fmt.Errorf("SLATE_SIGN_KEY: %w", err)
+		}
+		return nodeKey, exportKey, nil
+	}
+	return nodeKey, nodeKey, nil
+}

+// ---- the refusals --------------------------------------------------------
+
+// parts splits a vector into a header that can be mutated and its entry lines.
+func parts(t *testing.T, name string) (map[string]any, [][]byte) {
+	t.Helper()
+	lines, err := splitLines(loadVector(t, name))
+	if err != nil {
+		t.Fatalf("split %s: %v", name, err)
+	}
+	header, err := parseObject(lines[0])
+	if err != nil {
+		t.Fatalf("header %s: %v", name, err)
+	}
+	return header, lines[1:]
+}
+
+func emit(t *testing.T, header map[string]any, entries [][]byte) []byte {
+	t.Helper()
+	var out bytes.Buffer
+	line, err := json.Marshal(header)
+	if err != nil {
+		t.Fatalf("marshal header: %v", err)
+	}
+	out.Write(line)
+	out.WriteByte('\n')
+	for _, entry := range entries {
+		out.Write(entry)
+		out.WriteByte('\n')
+	}
+	return out.Bytes()
+}
+
+// resignAs signs the header as key. An exporter with a valid key can restate
+// anything the signature covers; the checks that only the proofs and the node's
+// key can catch are the ones below.
+func resignAs(t *testing.T, header map[string]any, entries [][]byte, key ed25519.PrivateKey) []byte {
+	t.Helper()
+	public, ok := key.Public().(ed25519.PublicKey)
+	if !ok {
+		t.Fatal("private key does not carry a public key")
+	}
+	header["signed_by"] = hex.EncodeToString(public)
+	preimage, err := preimageOf(header)
+	if err != nil {
+		t.Fatalf("preimage: %v", err)
+	}
+	header["signature"] = hex.EncodeToString(ed25519.Sign(key, preimage))
+	return emit(t, header, entries)
+}
+
+// dishonest is a key that is pinned but not trusted to behave: it can sign
+// whatever it likes, which is what a verifier has to survive.
+func dishonest() (ed25519.PrivateKey, ed25519.PublicKey) {
+	key := ed25519.NewKeyFromSeed(bytesOf('a', 32))
+	public, ok := key.Public().(ed25519.PublicKey)
+	if !ok {
+		panic("private key does not carry a public key")
+	}
+	return key, public
+}

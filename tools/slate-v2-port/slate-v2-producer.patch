+package bundle
+
+import (
+	"crypto/ed25519"
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/bigblue-r4/slate/internal/store"
+)
+
+func testKeys(t *testing.T) (ed25519.PrivateKey, ed25519.PrivateKey) {
+	t.Helper()
+	node := ed25519.NewKeyFromSeed(bytesOf('n', 32))
+	exporter := ed25519.NewKeyFromSeed(bytesOf('e', 32))
+	return node, exporter
+}
+
+func bytesOf(b byte, n int) []byte {
+	out := make([]byte, n)
+	for i := range out {
+		out[i] = b
+	}
+	return out
+}
+
+// testEntries is a seven-record log: CASE-A at seqs 2, 5 and 7, CASE-B at 1 and
+// 3, CASE-C at 4, and one record with no data at all.
+func testEntries() []store.Entry {
+	cases := map[int]string{1: "CASE-B", 2: "CASE-A", 3: "CASE-B", 4: "CASE-C", 5: "CASE-A", 7: "CASE-A"}
+	ts := time.Date(2026, 5, 12, 14, 0, 0, 0, time.UTC)
+	entries := make([]store.Entry, 7)
+	prev := strings.Repeat("0", 64)
+	for i := 1; i <= 7; i++ {
+		entry := store.Entry{
+			Seq:       uint64(i),
+			Timestamp: ts.Add(time.Duration(i) * time.Minute),
+			Level:     "INFO",
+			Event:     "slate/custody",
+			Source:    "slate",
+			PrevHash:  prev,
+		}
+		if c, ok := cases[i]; ok {
+			data, _ := json.Marshal(map[string]string{"case_number": c, "item_id": "ITEM-" + string(rune('0'+i))})
+			entry.Data = data
+		}
+		entries[i-1] = entry
+		line, _ := json.Marshal(entry)
+		sum := sha256.Sum256(line)
+		prev = hex.EncodeToString(sum[:])
+	}
+	return entries
+}
+
+func baseRequest(scope Scope) Request {
+	return Request{
+		Entries:     testEntries(),
+		Scope:       scope,
+		CaseNumber:  "",
+		Department:  "Honolulu PD",
+		Agency:      "Honolulu Police Department",
+		Seal:        "HPD-2026",
+		NodeID:      "node-001",
+		Actor:       "Sgt. Example",
+		Role:        "evidence_clerk",
+		BundleID:    "BUNDLE-20260512-a3b2c1d0",
+		GeneratedAt: time.Date(2026, 5, 12, 14, 30, 0, 0, time.UTC),
+	}
+}
+
+func TestPreimageMatchesTheSpecification(t *testing.T) {
+	root := strings.Repeat("9d2c", 16)
+	b := &Bundle{
+		Format:      Format,
+		BundleID:    "BUNDLE-20260512-a3b2c1d0",
+		GeneratedAt: "2026-05-12T14:30:00Z",
+		Scope:       "case",
+		CaseNumber:  "CASE-2026-0042",
+		Department:  "Honolulu PD",
+		Agency:      "Honolulu Police Department",
+		Seal:        "HPD-2026",
+		NodeID:      "node-001",
+		EntryCount:  7,
+		SHA256Chain: strings.Repeat("9f1c", 16),
+		ExportActor: "Sgt. Example",
+		ExportRole:  "evidence_clerk",
+		SignedBy:    strings.Repeat("3b1f", 16),
+		LogHead: LogHead{
+			Size:      41207,
+			Root:      root,
+			TS:        "2026-05-12T14:29:58Z",
+			Sig:       strings.Repeat("ff", 64),
+			SignerKey: strings.Repeat("8a01", 16),
+		},
+	}
+	want := "witness-bundle/2\n" +
+		"bundle_id=BUNDLE-20260512-a3b2c1d0\n" +
+		"generated_at=2026-05-12T14:30:00Z\n" +
+		"scope=case\n" +
+		"case_number=CASE-2026-0042\n" +
+		"department=Honolulu PD\n" +
+		"agency=Honolulu Police Department\n" +
+		"seal=HPD-2026\n" +
+		"node_id=node-001\n" +
+		"entry_count=7\n" +
+		"sha256_chain=" + strings.Repeat("9f1c", 16) + "\n" +
+		"export_actor=Sgt. Example\n" +
+		"export_role=evidence_clerk\n" +
+		"signed_by=" + strings.Repeat("3b1f", 16) + "\n" +
+		"log_head.size=41207\n" +
+		"log_head.root=" + root + "\n" +
+		"log_head.ts=2026-05-12T14:29:58Z\n" +
+		"log_head.signer_key=" + strings.Repeat("8a01", 16) + "\n"
+	got, err := Preimage(b)
+	if err != nil {
+		t.Fatalf("preimage: %v", err)
+	}
+	if string(got) != want {
+		t.Fatalf("preimage mismatch\n got:\n%s\nwant:\n%s", got, want)
+	}
+}
+
+func TestCaseBundleBindsEntriesToTheFullLog(t *testing.T) {
+	node, exporter := testKeys(t)
+	req := baseRequest(ScopeCase)
+	req.CaseNumber = "CASE-A"
+	b, err := Export(req, node, exporter)
+	if err != nil {
+		t.Fatalf("export: %v", err)
+	}
+	if b.EntryCount != 3 {
+		t.Fatalf("entry_count = %d, want 3", b.EntryCount)
+	}
+	if b.LogHead.Size != 7 {
+		t.Fatalf("head size = %d, want 7", b.LogHead.Size)
+	}
+	if b.SignedBy != hex.EncodeToString(exporter.Public().(ed25519.PublicKey)) {
+		t.Fatal("signed_by is not the export key")
+	}
+	if b.LogHead.SignerKey != hex.EncodeToString(node.Public().(ed25519.PublicKey)) {
+		t.Fatal("log_head.signer_key is not the node key")
+	}
+	wantSeqs := []uint64{2, 5, 7}
+	wantIndices := []uint64{1, 4, 6}
+	for i, proof := range b.Proofs {
+		if proof.Seq != wantSeqs[i] || proof.Index != wantIndices[i] {
+			t.Fatalf("proof %d = seq %d index %d", i, proof.Seq, proof.Index)
+		}
+		if proof.Size != 7 {
+			t.Fatalf("proof %d size = %d", i, proof.Size)
+		}
+	}
+
+	// The header signature verifies over the preimage.
+	preimage, err := Preimage(b)
+	if err != nil {
+		t.Fatalf("preimage: %v", err)
+	}
+	sig, _ := hex.DecodeString(b.Signature)
+	if !ed25519.Verify(exporter.Public().(ed25519.PublicKey), preimage, sig) {
+		t.Fatal("bundle signature does not verify")
+	}
+	// The head signature verifies over size_be8 || root.
+	root, _ := hex.DecodeString(b.LogHead.Root)
+	headSig, _ := hex.DecodeString(b.LogHead.Sig)
+	var input [40]byte
+	binary.BigEndian.PutUint64(input[:8], b.LogHead.Size)
+	copy(input[8:], root)
+	if !ed25519.Verify(node.Public().(ed25519.PublicKey), input[:], headSig) {
+		t.Fatal("head signature does not verify")
+	}
+
+	// The entry lines are the store's bytes, and the digest covers exactly them.
+	data, err := b.Bytes()
+	if err != nil {
+		t.Fatalf("bytes: %v", err)
+	}
+	lines := strings.Split(strings.TrimSuffix(string(data), "\n"), "\n")
+	if len(lines) != 1+b.EntryCount {
+		t.Fatalf("encoded %d lines, want %d", len(lines), 1+b.EntryCount)
+	}
+	entries := testEntries()
+	for i, index := range []int{1, 4, 6} {
+		line, _ := json.Marshal(entries[index])
+		if lines[i+1] != string(line) {
+			t.Fatalf("entry line %d is not the store's bytes", i)
+		}
+	}
+	chain := sha256.Sum256(append([]byte(lines[1]), []byte(strings.Join(lines[2:], ""))...))
+	if b.SHA256Chain != hex.EncodeToString(chain[:]) {
+		t.Fatal("sha256_chain does not cover the entry lines")
+	}
+}
+
+func TestEveryLeafProvesToTheRoot(t *testing.T) {
+	for size := 1; size <= 9; size++ {
+		leaves := make([][32]byte, size)
+		for i := range leaves {
+			leaves[i] = hashLeaf([]byte{byte(i), 'x'})
+		}
+		tree := newTree(leaves)
+		root := tree.rootHash()
+		for index := 0; index < size; index++ {
+			path := tree.prove(index)
+			got, ok := recompute(leaves[index], index, size, path)
+			if !ok || got != root {
+				t.Fatalf("size %d index %d does not recompute the root", size, index)
+			}
+		}
+	}
+}
+
+// recompute is the verifier's rule, written independently of the producer: a
+// path of the wrong length is a failure, not a zero root.
+func recompute(h [32]byte, index, size int, path [][32]byte) ([32]byte, bool) {
+	if size == 1 {
+		return h, true
+	}
+	if len(path) == 0 {
+		return [32]byte{}, false
+	}
+	k := splitPoint(size)
+	sibling := path[len(path)-1]
+	inner := path[:len(path)-1]
+	if index < k {
+		left, ok := recompute(h, index, k, inner)
+		return hashNode(left, sibling), ok
+	}
+	right, ok := recompute(h, index-k, size-k, inner)
+	return hashNode(sibling, right), ok
+}
+
+func TestLogScopeCarriesEveryEntry(t *testing.T) {
+	node, exporter := testKeys(t)
+	req := baseRequest(ScopeLog)
+	b, err := Export(req, node, exporter)
+	if err != nil {
+		t.Fatalf("export: %v", err)
+	}
+	if b.EntryCount != 7 || len(b.Proofs) != 7 {
+		t.Fatalf("entry_count = %d proofs = %d", b.EntryCount, len(b.Proofs))
+	}
+	if b.LogHead.Size != 7 {
+		t.Fatalf("head size = %d", b.LogHead.Size)
+	}
+}
+
+func TestEmptyCaseIsAnEmptyBundle(t *testing.T) {
+	node, exporter := testKeys(t)
+	req := baseRequest(ScopeCase)
+	req.CaseNumber = "CASE-MISSING"
+	b, err := Export(req, node, exporter)
+	if err != nil {
+		t.Fatalf("export: %v", err)
+	}
+	if b.EntryCount != 0 || len(b.Proofs) != 0 {
+		t.Fatalf("entry_count = %d proofs = %d", b.EntryCount, len(b.Proofs))
+	}
+	if b.LogHead.Size != 7 {
+		t.Fatalf("head size = %d", b.LogHead.Size)
+	}
+	if b.SHA256Chain != "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" {
+		t.Fatalf("empty chain = %s", b.SHA256Chain)
+	}
+}
+
+func TestRefusesValuesThatCannotBeSignedUnambiguously(t *testing.T) {
+	node, exporter := testKeys(t)
+	req := baseRequest(ScopeCase)
+	req.CaseNumber = "CASE-A"
+	req.Department = "Honolulu PD\nextra=field"
+	if _, err := Export(req, node, exporter); err == nil {
+		t.Fatal("a newline in department was accepted")
+	}
+
+	req = baseRequest(ScopeCase)
+	req.CaseNumber = "CASE-A"
+	req.Actor = "Sgt.\rInjected"
+	if _, err := Export(req, node, exporter); err == nil {
+		t.Fatal("a carriage return in export_actor was accepted")
+	}
+}
+
+func TestRefusesSequenceGaps(t *testing.T) {
+	node, exporter := testKeys(t)
+	req := baseRequest(ScopeLog)
+	req.Entries[2].Seq = 9
+	if _, err := Export(req, node, exporter); err == nil {
+		t.Fatal("a seq gap was accepted")
+	}
+}
+
+func TestScopeRules(t *testing.T) {
+	node, exporter := testKeys(t)
+	req := baseRequest(ScopeCase)
+	if _, err := Export(req, node, exporter); err == nil {
+		t.Fatal("scope=case with no case number was accepted")
+	}
+	req = baseRequest(ScopeLog)
+	req.CaseNumber = "CASE-A"
+	if _, err := Export(req, node, exporter); err == nil {
+		t.Fatal("scope=log with a case number was accepted")
+	}
+}
+
+func TestWriteNDJSONRefusesToReplaceAnIssuedBundle(t *testing.T) {
+	node, exporter := testKeys(t)
+	req := baseRequest(ScopeCase)
+	req.CaseNumber = "CASE-A"
+	b, err := Export(req, node, exporter)
+	if err != nil {
+		t.Fatalf("export: %v", err)
+	}
+	path := filepath.Join(t.TempDir(), "exports", b.BundleID+".ndjson")
+	if err := b.WriteNDJSON(path); err != nil {
+		t.Fatalf("write: %v", err)
+	}
+	if _, err := os.Stat(path); err != nil {
+		t.Fatalf("bundle not written: %v", err)
+	}
+	if err := b.WriteNDJSON(path); err == nil {
+		t.Fatal("an existing bundle was overwritten")
+	}
+}
diff --git a/internal/bundle/merkle.go b/internal/bundle/merkle.go
new file mode 100644
index 0000000..7bbd369
--- /dev/null
+++ b/internal/bundle/merkle.go
@@ -0,0 +1,119 @@
+package bundle
+
+// The log's Merkle tree: RFC 6962 shape over BLAKE3, with the entry line's bytes
+// as the leaf preimage.
+//
+//	leaf = BLAKE3(0x00 || line)
+//	node = BLAKE3(0x01 || left || right)
+//
+// The split point for a subtree of n leaves is the largest power of two strictly
+// less than n, matching the witness core's merkle package. Audit paths are
+// leaf-first: the innermost sibling is first and the root's sibling is last,
+// which is the order witness-bundle/2 carries.
+
+import "lukechampine.com/blake3"
+
+const (
+	leafPrefix = byte(0x00)
+	nodePrefix = byte(0x01)
+)
+
+func hashLeaf(line []byte) [32]byte {
+	h := blake3.New(32, nil)
+	_, _ = h.Write([]byte{leafPrefix})
+	_, _ = h.Write(line)
+	var out [32]byte
+	copy(out[:], h.Sum(nil))
+	return out
+}
+
+func hashNode(left, right [32]byte) [32]byte {
+	h := blake3.New(32, nil)
+	_, _ = h.Write([]byte{nodePrefix})
+	_, _ = h.Write(left[:])
+	_, _ = h.Write(right[:])
+	var out [32]byte
+	copy(out[:], h.Sum(nil))
+	return out
+}
+
+// splitPoint returns the largest power of two strictly less than n, for n > 1.
+func splitPoint(n int) int {
+	k := 1
+	for k < n {
+		k <<= 1
+	}
+	return k >> 1
+}
+
+// tree is a built Merkle tree. Building once makes an audit path O(log n)
+// instead of recomputing sibling subtrees per proof.
+type tree struct {
+	root *treeNode
+}
+
+type treeNode struct {
+	hash        [32]byte
+	count       int
+	left, right *treeNode
+}
+
+func newTree(leaves [][32]byte) *tree {
+	if len(leaves) == 0 {
+		return &tree{}
+	}
+	return &tree{root: buildTree(leaves)}
+}
+
+func buildTree(leaves [][32]byte) *treeNode {
+	if len(leaves) == 1 {
+		return &treeNode{hash: leaves[0], count: 1}
+	}
+	k := splitPoint(len(leaves))
+	left := buildTree(leaves[:k])
+	right := buildTree(leaves[k:])
+	return &treeNode{
+		hash:  hashNode(left.hash, right.hash),
+		count: left.count + right.count,
+		left:  left,
+		right: right,
+	}
+}
+
+func (t *tree) size() int {
+	if t.root == nil {
+		return 0
+	}
+	return t.root.count
+}
+
+func (t *tree) rootHash() [32]byte {
+	if t.root == nil {
+		return [32]byte{}
+	}
+	return t.root.hash
+}
+
+// prove returns the leaf-first audit path for index, or nil if the index is
+// outside the tree.
+func (t *tree) prove(index int) [][32]byte {
+	if t.root == nil || index < 0 || index >= t.root.count {
+		return nil
+	}
+	var path [][32]byte
+	collectPath(t.root, index, &path)
+	return path
+}
+
+func collectPath(n *treeNode, index int, path *[][32]byte) {
+	if n.left == nil || n.right == nil {
+		return
+	}
+	if index < n.left.count {
+		collectPath(n.left, index, path)
+		*path = append(*path, n.right.hash)
+		return
+	}
+	collectPath(n.right, index-n.left.count, path)
+	*path = append(*path, n.left.hash)
+}

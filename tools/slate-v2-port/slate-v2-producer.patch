+			file.Write(entry)
+			file.WriteByte('\n')
+		}
+		if got := stepOf(t, verifyBundleStep(file.Bytes(), pins)); got != "preimage" {
+			t.Fatalf("step %q, want preimage", got)
+		}
+	})
+}
+
+func TestADishonestExporterWithAPinnedKey(t *testing.T) {
+	key, public := dishonest()
+	pins := []ed25519.PublicKey{public, readPin(t, "v2-case.node.pub")}
+
+	t.Run("a substituted entry fails inclusion", func(t *testing.T) {
+		// The exporter can re-sign and recompute the chain, because it owns the
+		// chain and the header. It cannot make new bytes a leaf of the node's
+		// tree, and this is the only check that catches it.
+		header, entries := parts(t, "v2-case")
+		entry, err := parseObject(entries[0])
+		if err != nil {
+			t.Fatal(err)
+		}
+		payload, ok := entry["data"].(map[string]any)
+		if !ok {
+			t.Fatal("the first entry has no data object")
+		}
+		if payload["item_id"] != "ITEM-000" {
+			t.Fatalf("first entry item_id %v, want ITEM-000", payload["item_id"])
+		}
+		payload["item_id"] = "ITEM-999"
+		entries[0], err = json.Marshal(entry)
+		if err != nil {
+			t.Fatal(err)
+		}
+		digest := sha256.Sum256(bytes.Join(entries, nil))
+		header["sha256_chain"] = hex.EncodeToString(digest[:])
+
+		if got := stepOf(t, verifyBundleStep(resignAs(t, header, entries, key), pins)); got != "inclusion" {
+			t.Fatalf("step %q, want inclusion", got)
+		}
+	})
+
+	t.Run("a restated head fails at the head signature", func(t *testing.T) {
+		// The head signature covers size||root under the node's key, so an
+		// exporter cannot point the bundle at a different tree.
+		header, entries := parts(t, "v2-case")
+		head := header["log_head"].(map[string]any)
+		head["root"] = strings.Repeat("00", 32)
+		if got := stepOf(t, verifyBundleStep(resignAs(t, header, entries, key), pins)); got != "head" {
+			t.Fatalf("step %q, want head", got)
+		}
+	})
+
+	t.Run("an empty case bundle is still a signed claim", func(t *testing.T) {
+		// A case with no records is a real artifact: the head still proves the
+		// node kept a log, and an empty proof list is the honest answer.
+		header, _ := parts(t, "v2-case")
+		empty := sha256.Sum256(nil)
+		header["entry_count"] = json.Number("0")
+		header["sha256_chain"] = hex.EncodeToString(empty[:])
+		header["proofs"] = []any{}
+
+		got, err := verifyBundle(resignAs(t, header, nil, key), pins...)
+		if err != nil {
+			t.Fatalf("an empty case bundle was refused: %v", err)
+		}
+		if got.entries != 0 {
+			t.Fatalf("entries %d, want 0", got.entries)
+		}
+	})
+}

diff --git a/internal/bundle/merkle.go b/internal/bundle/merkle.go
new file mode 100644
index 0000000..7bbd369
--- /dev/null
+++ b/internal/bundle/merkle.go
@@ -0,0 +1,119 @@
+package bundle
+
+// The log's Merkle tree: RFC 6962 shape over BLAKE3, with the entry line's bytes
+// as the leaf preimage.
+//
+//	leaf = BLAKE3(0x00 || line)
+//	node = BLAKE3(0x01 || left || right)
+//
+// The split point for a subtree of n leaves is the largest power of two strictly
+// less than n, matching the witness core's merkle package. Audit paths are
+// leaf-first: the innermost sibling is first and the root's sibling is last,
+// which is the order witness-bundle/2 carries.
+
+import "lukechampine.com/blake3"
+
+const (
+	leafPrefix = byte(0x00)
+	nodePrefix = byte(0x01)
+)
+
+func hashLeaf(line []byte) [32]byte {
+	h := blake3.New(32, nil)
+	_, _ = h.Write([]byte{leafPrefix})
+	_, _ = h.Write(line)
+	var out [32]byte
+	copy(out[:], h.Sum(nil))
+	return out
+}
+
+func hashNode(left, right [32]byte) [32]byte {
+	h := blake3.New(32, nil)
+	_, _ = h.Write([]byte{nodePrefix})
+	_, _ = h.Write(left[:])
+	_, _ = h.Write(right[:])
+	var out [32]byte
+	copy(out[:], h.Sum(nil))
+	return out
+}
+
+// splitPoint returns the largest power of two strictly less than n, for n > 1.
+func splitPoint(n int) int {
+	k := 1
+	for k < n {
+		k <<= 1
+	}
+	return k >> 1
+}
+
+// tree is a built Merkle tree. Building once makes an audit path O(log n)
+// instead of recomputing sibling subtrees per proof.
+type tree struct {
+	root *treeNode
+}
+
+type treeNode struct {
+	hash        [32]byte
+	count       int
+	left, right *treeNode
+}
+
+func newTree(leaves [][32]byte) *tree {
+	if len(leaves) == 0 {
+		return &tree{}
+	}
+	return &tree{root: buildTree(leaves)}
+}
+
+func buildTree(leaves [][32]byte) *treeNode {
+	if len(leaves) == 1 {
+		return &treeNode{hash: leaves[0], count: 1}
+	}
+	k := splitPoint(len(leaves))
+	left := buildTree(leaves[:k])
+	right := buildTree(leaves[k:])
+	return &treeNode{
+		hash:  hashNode(left.hash, right.hash),
+		count: left.count + right.count,
+		left:  left,
+		right: right,
+	}
+}
+
+func (t *tree) size() int {
+	if t.root == nil {
+		return 0
+	}
+	return t.root.count
+}
+
+func (t *tree) rootHash() [32]byte {
+	if t.root == nil {
+		return [32]byte{}
+	}
+	return t.root.hash
+}
+
+// prove returns the leaf-first audit path for index, or nil if the index is
+// outside the tree.
+func (t *tree) prove(index int) [][32]byte {
+	if t.root == nil || index < 0 || index >= t.root.count {
+		return nil
+	}
+	var path [][32]byte
+	collectPath(t.root, index, &path)
+	return path
+}
+
+func collectPath(n *treeNode, index int, path *[][32]byte) {
+	if n.left == nil || n.right == nil {
+		return
+	}
+	if index < n.left.count {
+		collectPath(n.left, index, path)
+		*path = append(*path, n.right.hash)
+		return
+	}
+	collectPath(n.right, index-n.left.count, path)
+	*path = append(*path, n.left.hash)
+}

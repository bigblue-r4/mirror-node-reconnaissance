+package bundle
+
+// The shared witness-bundle/2 vectors, and a reader to check them with.
+//
+// The fixtures in testdata/ were not written by this package: three came from a
+// scratch Go emitter built from the schema and then deleted, two from the Rust
+// producer in core/bundle, one from slate's own export path. The public halves
+// of the keys that signed them sit beside them, and a bundle is only ever
+// checked against those pins, never against the key it names for itself.
+//
+// The verifier below is a reader: it parses the header text, rebuilds the
+// preimage from the fields it finds there, and recomputes the tree from the
+// entry lines as written. That is a second, deliberately separate transcription
+// of section 4, so a bundle that satisfies one and not the other is a real
+// disagreement between implementations rather than a bug they share. It lives in
+// the test binary only: this package is a producer, and shipping a verifier
+// alongside it would undo the reason the format has one.
+//
+// The point of carrying the vectors into slate is that the format is now checked
+// on every change to slate, in slate's own CI, without the verifier repository
+// in the loop.
+
+import (
+	"bytes"
+	"crypto/ed25519"
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+)
+
+// rejection names the section 4.7 step that refused a bundle. The names match
+// the independent Python verifier's vocabulary, so a failure reported by either
+// implementation reads the same.
+type rejection struct {
+	step   string
+	detail string
+}
+
+func (r *rejection) Error() string { return r.step + ": " + r.detail }
+
+func refuse(step, format string, args ...any) error {
+	return &rejection{step: step, detail: fmt.Sprintf(format, args...)}
+}
+
+func stepOf(t *testing.T, err error) string {
+	t.Helper()
+	var r *rejection
+	if !errors.As(err, &r) {
+		t.Fatalf("expected a rejected step, got %v", err)
+	}
+	return r.step
+}
+
+// verifiedBundle is what a successful check learned about a file.
+type verifiedBundle struct {
+	entries   int
+	size      uint64
+	root      [32]byte
+	chain     string
+	seqs      []uint64
+	paths     [][][32]byte
+	pathLens  []int
+	exportKey ed25519.PublicKey
+	headKey   ed25519.PublicKey
+}
+
+func loadVector(t *testing.T, name string) []byte {
+	t.Helper()
+	data, err := os.ReadFile(filepath.Join("testdata", name+".ndjson"))
+	if err != nil {
+		t.Fatalf("read fixture %s: %v", name, err)
+	}
+	return data
+}
+
+func readPin(t *testing.T, name string) ed25519.PublicKey {
+	t.Helper()
+	text, err := os.ReadFile(filepath.Join("testdata", name))
+	if err != nil {
+		t.Fatalf("read pin %s: %v", name, err)
+	}
+	raw, err := hex.DecodeString(strings.TrimSpace(string(text)))
+	if err != nil || len(raw) != ed25519.PublicKeySize {
+		t.Fatalf("pin %s is not a %d-byte key", name, ed25519.PublicKeySize)
+	}
+	return ed25519.PublicKey(raw)
+}
+
+func loadPins(t *testing.T, names ...string) []ed25519.PublicKey {
+	t.Helper()
+	pins := make([]ed25519.PublicKey, 0, len(names))
+	for _, name := range names {
+		pins = append(pins, readPin(t, name))
+	}
+	return pins
+}
+
+func mustVerify(t *testing.T, name string, pins ...ed25519.PublicKey) *verifiedBundle {
+	t.Helper()
+	got, err := verifyBundle(loadVector(t, name), pins...)
+	if err != nil {
+		t.Fatalf("%s does not verify: %v", name, err)
+	}
+	return got
+}
+
+// casePins are the two pins the v2 case bundle was signed with.
+func casePins(t *testing.T) []ed25519.PublicKey {
+	t.Helper()
+	return loadPins(t, "v2-case.export.pub", "v2-case.node.pub")
+}
+
+// ---- the reader ----------------------------------------------------------
+
+func verifyBundle(data []byte, pins ...ed25519.PublicKey) (*verifiedBundle, error) {
+	lines, err := splitLines(data)
+	if err != nil {
+		return nil, err
+	}
+	header, err := parseObject(lines[0])
+	if err != nil {
+		return nil, refuse("header", "header line is not a JSON object: %v", err)
+	}
+	if format, _ := header["format"].(string); format != Format {
+		return nil, refuse("dispatch", "unknown format %v", header["format"])
+	}
+	count, err := numberField(header, "entry_count")
+	if err != nil {
+		return nil, err
+	}
+
+	// 3. both keys pinned, before any signature is believed.
+	exportKey, err := pinnedKey(pins, header, "signed_by", "bundle signer")
+	if err != nil {
+		return nil, err
+	}
+	head, ok := header["log_head"].(map[string]any)
+	if !ok {
+		return nil, refuse("header", "log_head is not an object")
+	}
+	headKey, err := pinnedKey(pins, head, "signer_key", "log head signer")
+	if err != nil {
+		return nil, err
+	}
+
+	// 4. the bundle signature, over the preimage rebuilt from the header.
+	signature, err := hexField(header, "signature", ed25519.SignatureSize)
+	if err != nil {
+		return nil, err
+	}
+	preimage, err := preimageOf(header)
+	if err != nil {
+		return nil, err
+	}
+	if !ed25519.Verify(exportKey, preimage, signature) {
+		return nil, refuse("signature", "bundle signature does not verify")
+	}
+
+	// 5. the header must describe the bytes that follow it.
+	entries := lines[1:]
+	if uint64(len(entries)) != count {
+		return nil, refuse("count", "entry_count %d, file has %d lines", count, len(entries))
+	}
+	digest := sha256.Sum256(bytes.Join(entries, nil))
+	chain, err := textField(header, "sha256_chain")
+	if err != nil {
+		return nil, err
+	}
+	if !strings.EqualFold(chain, hex.EncodeToString(digest[:])) {
+		return nil, refuse("digest", "sha256_chain does not match the entry lines")
+	}
+
+	// 6. the head is the node's statement about the log it kept.
+	size, err := numberField(head, "size")
+	if err != nil {
+		return nil, err
+	}
+	root, err := hexField(head, "root", 32)
+	if err != nil {
+		return nil, err
+	}
+	headSignature, err := hexField(head, "sig", ed25519.SignatureSize)
+	if err != nil {
+		return nil, err
+	}
+	headInput := make([]byte, 40)
+	binary.BigEndian.PutUint64(headInput[:8], size)
+	copy(headInput[8:], root)
+	var rootHash [32]byte
+	copy(rootHash[:], root)
+	if !ed25519.Verify(headKey, headInput, headSignature) {
+		return nil, refuse("head", "log head signature does not verify")
+	}
+
+	// 7. the case claim, and the sequence it is made about.
+	scope, err := textField(header, "scope")
+	if err != nil {
+		return nil, err
+	}
+	caseNumber, err := textField(header, "case_number")
+	if err != nil {
+		return nil, err
+	}
+	switch {
+	case scope != string(ScopeCase) && scope != string(ScopeLog):
+		return nil, refuse("scope", "unknown scope %q", scope)
+	case scope == string(ScopeCase) && caseNumber == "":
+		return nil, refuse("scope", "scope=case requires a non-empty case_number")
+	case scope == string(ScopeLog) && caseNumber != "":
+		return nil, refuse("scope", "scope=log requires an empty case_number")
+	case scope == string(ScopeLog) && count != size:
+		return nil, refuse("scope", "scope=log with entry_count %d under a head of %d", count, size)
+	}
+
+	seqs := make([]uint64, len(entries))
+	var previous uint64
+	for i, line := range entries {
+		entry, err := parseObject(line)
+		if err != nil {
+			return nil, refuse("entries", "entry line %d is not a JSON object: %v", i+1, err)
+		}
+		seq, err := numberField(entry, "seq")
+		if err != nil {
+			return nil, err
+		}
+		if seq <= previous {
+			return nil, refuse("entries", "seq %d is not ascending (after %d)", seq, previous)
+		}
+		previous = seq
+		seqs[i] = seq
+		if scope != string(ScopeCase) {
+			continue
+		}
+		payload, _ := entry["data"].(map[string]any)
+		got, _ := payload["case_number"].(string)
+		if got != caseNumber {
+			return nil, refuse("scope", "entry seq %d has case_number %q, header says %q",
+				seq, got, caseNumber)
+		}
+	}
+
+	// 8. every entry is the leaf its proof claims, under that root.
+	rawProofs, ok := header["proofs"].([]any)
+	if !ok {
+		return nil, refuse("proofs", "proofs is not an array")
+	}
+	bySeq := make(map[uint64]map[string]any, len(rawProofs))
+	for _, item := range rawProofs {
+		proof, ok := item.(map[string]any)
+		if !ok {
+			return nil, refuse("proofs", "proof is not an object")
+		}
+		seq, err := numberField(proof, "seq")
+		if err != nil {
+			return nil, err
+		}
+		if _, duplicate := bySeq[seq]; duplicate {
+			return nil, refuse("proofs", "duplicate proof for seq %d", seq)
+		}
+		bySeq[seq] = proof
+	}
+	if len(bySeq) != len(entries) {
+		return nil, refuse("proofs", "%d proofs for %d entries", len(bySeq), len(entries))
+	}
+
+	paths := make([][][32]byte, len(entries))
+	pathLens := make([]int, len(entries))
+	for i, seq := range seqs {
+		proof, present := bySeq[seq]
+		if !present {
+			return nil, refuse("proofs", "entry seq %d has no inclusion proof", seq)
+		}
+		index, err := numberField(proof, "index")
+		if err != nil {
+			return nil, err
+		}
+		proofSize, err := numberField(proof, "size")
+		if err != nil {
+			return nil, err
+		}
+		if proofSize != size {
+			return nil, refuse("proofs", "entry seq %d: proof names a tree of %d, head is %d",
+				seq, proofSize, size)
+		}
+		if index != seq-1 {
+			return nil, refuse("proofs", "entry seq %d: proof index %d, expected %d",
+				seq, index, seq-1)
+		}
+		path, err := proofPath(proof, seq)
+		if err != nil {
+			return nil, err
+		}
+		if !includes(rootHash, hashLeaf(entries[i]), index, proofSize, path) {
+			return nil, refuse("inclusion", "entry seq %d is not in the tree the head signed", seq)
+		}
+		paths[i] = path
+		pathLens[i] = len(path)
+	}
+
+	return &verifiedBundle{
+		entries:   len(entries),
+		size:      size,
+		root:      rootHash,
+		chain:     chain,
+		seqs:      seqs,
+		paths:     paths,
+		pathLens:  pathLens,
+		exportKey: exportKey,
+		headKey:   headKey,
+	}, nil
+}
+
+// splitLines is step 1: the container is NDJSON with no tolerance for reformatting,
+// because every byte of an entry line is a leaf.
+func splitLines(data []byte) ([][]byte, error) {
+	if len(data) == 0 {
+		return nil, refuse("split", "file is empty")
+	}
+	if bytes.ContainsRune(data, '\r') {
+		return nil, refuse("split", "file contains CR; the format is newline terminated")
+	}
+	if !bytes.HasSuffix(data, []byte("\n")) {
+		return nil, refuse("split", "file does not end with a newline")
+	}
+	lines := bytes.Split(data[:len(data)-1], []byte("\n"))
+	for i, line := range lines {
+		if len(line) == 0 {
+			return nil, refuse("split", "line %d is blank", i+1)
+		}
+	}
+	return lines, nil
+}
+
+func parseObject(line []byte) (map[string]any, error) {
+	decoder := json.NewDecoder(bytes.NewReader(line))
+	decoder.UseNumber()
+	var object map[string]any
+	if err := decoder.Decode(&object); err != nil {
+		return nil, err
+	}
+	if object == nil {
+		return nil, errors.New("not an object")
+	}
+	return object, nil
+}
+
+// textField reads an optional string; absent means empty, as in section 4.3.
+func textField(object map[string]any, field string) (string, error) {
+	raw, present := object[field]
+	if !present || raw == nil {
+		return "", nil
+	}
+	value, ok := raw.(string)
+	if !ok {
+		return "", refuse("header", "%s is not a string", field)
+	}
+	return value, nil
+}
+
+func numberField(object map[string]any, field string) (uint64, error) {
+	raw, present := object[field]
+	if !present || raw == nil {
+		return 0, refuse("header", "%s is required", field)
+	}
+	number, ok := raw.(json.Number)
+	if !ok {
+		return 0, refuse("header", "%s is not a number", field)
+	}
+	value, err := strconv.ParseUint(number.String(), 10, 64)
+	if err != nil {
+		return 0, refuse("header", "%s is not a non-negative integer: %v", field, err)
+	}
+	return value, nil
+}
+
+func hexField(object map[string]any, field string, size int) ([]byte, error) {
+	text, err := textField(object, field)
+	if err != nil {
+		return nil, err
+	}
+	if text == "" {
+		return nil, refuse("header", "%s is required", field)
+	}
+	raw, err := hex.DecodeString(text)
+	if err != nil || len(raw) != size {
+		return nil, refuse("header", "%s is not %d hex-encoded bytes", field, size)
+	}
+	return raw, nil
+}
+
+func pinnedKey(pins []ed25519.PublicKey, object map[string]any, field, what string) (ed25519.PublicKey, error) {
+	text, err := textField(object, field)
+	if err != nil {
+		return nil, err
+	}
+	raw, err := hex.DecodeString(text)
+	if err != nil || len(raw) != ed25519.PublicKeySize {
+		return nil, refuse("pin", "%s %q is not a %d-byte key", what, text, ed25519.PublicKeySize)
+	}
+	for _, pin := range pins {
+		if bytes.Equal(raw, pin) {
+			return pin, nil
+		}
+	}
+	return nil, refuse("pin", "%s %s is not in the pinned set", what, text)
+}
+
+func proofPath(proof map[string]any, seq uint64) ([][32]byte, error) {
+	raw, ok := proof["path"].([]any)
+	if !ok {
+		return nil, refuse("proofs", "entry seq %d: path is not an array", seq)
+	}
+	path := make([][32]byte, len(raw))
+	for i, node := range raw {
+		text, ok := node.(string)
+		if !ok {
+			return nil, refuse("proofs", "entry seq %d: malformed proof node", seq)
+		}
+		decoded, err := hex.DecodeString(text)
+		if err != nil || len(decoded) != 32 {
+			return nil, refuse("proofs", "entry seq %d: malformed proof node", seq)
+		}
+		copy(path[i][:], decoded)
+	}
+	return path, nil
+}
+
+// preimageOf rebuilds section 4.3 from the header as parsed. Fields outside the
+// list are ignored, which is what lets a producer add one without breaking
+// signatures — and what stops one from smuggling a field into the preimage.
+func preimageOf(header map[string]any) ([]byte, error) {
+	head, ok := header["log_head"].(map[string]any)
+	if !ok {
+		return nil, refuse("preimage", "log_head is not an object")
+	}
+	var out strings.Builder
+	out.WriteString(Format)
+	out.WriteByte('\n')
+	for _, field := range []string{
+		"bundle_id", "generated_at", "scope", "case_number", "department",
+		"agency", "seal", "node_id", "entry_count", "sha256_chain",
+		"export_actor", "export_role", "signed_by",
+	} {
+		value, err := preimageValue(header, field)
+		if err != nil {
+			return nil, err
+		}
+		if strings.ContainsAny(value, "\r\n") {
+			return nil, refuse("preimage", "%s contains a line break", field)
+		}
+		out.WriteString(field)
+		out.WriteByte('=')
+		out.WriteString(value)
+		out.WriteByte('\n')
+	}
+	for _, field := range []string{"size", "root", "ts", "signer_key"} {
+		value, err := preimageValue(head, field)
+		if err != nil {
+			return nil, err
+		}
+		if strings.ContainsAny(value, "\r\n") {
+			return nil, refuse("preimage", "log_head.%s contains a line break", field)
+		}
+		out.WriteString("log_head.")
+		out.WriteString(field)
+		out.WriteByte('=')
+		out.WriteString(value)
+		out.WriteByte('\n')
+	}
+	return []byte(out.String()), nil
+}
+
+func preimageValue(object map[string]any, field string) (string, error) {
+	if field == "entry_count" || field == "size" {
+		number, err := numberField(object, field)
+		if err != nil {
+			return "", err
+		}
+		return strconv.FormatUint(number, 10), nil
+	}
+	return textField(object, field)
+}
+
+// includes folds one audit path from the leaf to the root by the rule in section
+// 4.5: hash the sibling on the left when the running index is odd or is already
+// the last leaf of its subtree, and finish only when both indices are exhausted.
+// A path that is too short, too long, or belongs to another tree leaves one
+// behind and is refused.
+func includes(root, leaf [32]byte, index, size uint64, path [][32]byte) bool {
+	if size == 0 || index >= size {
+		return false
+	}
+	fn, sn := index, size-1
+	running := leaf
+	for _, sibling := range path {
+		if sn == 0 {
+			return false
+		}
+		if fn&1 == 1 || fn == sn {
+			running = hashNode(sibling, running)
+			for fn&1 == 0 && fn != 0 {
+				fn >>= 1
+				sn >>= 1
+			}
+		} else {
+			running = hashNode(running, sibling)
+		}
+		fn >>= 1
+		sn >>= 1
+	}
+	return sn == 0 && running == root
+}

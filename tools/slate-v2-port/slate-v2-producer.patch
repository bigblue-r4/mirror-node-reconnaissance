+	"github.com/bigblue-r4/slate/internal/peer"
+)
+
+// newExportServer builds a server with two cases in its log and the node and
+// export keys set in the environment.
+func newExportServer(t *testing.T) (*server, string, string) {
+	t.Helper()
+	dir := t.TempDir()
+	ev, err := evidence.Open(dir, intKey())
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = ev.Close() })
+	if err := ev.RecordIntake(&evidence.Item{CaseNumber: "C-1", Description: "seized laptop", Category: "digital_media"}, "clerk", "evidence_clerk"); err != nil {
+		t.Fatal(err)
+	}
+	if err := ev.RecordIntake(&evidence.Item{CaseNumber: "C-1", Description: "bank statements", Category: "documents"}, "clerk", "evidence_clerk"); err != nil {
+		t.Fatal(err)
+	}
+	if err := ev.RecordIntake(&evidence.Item{CaseNumber: "C-2", Description: "unrelated"}, "clerk", "evidence_clerk"); err != nil {
+		t.Fatal(err)
+	}
+
+	nodePub, nodePriv, err := peer.GenerateNodeKey()
+	if err != nil {
+		t.Fatal(err)
+	}
+	exportPub, exportPriv, err := slateexport.GenerateKeyPair()
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv(peer.NodeKeyEnv, nodePriv)
+	t.Setenv("SLATE_SIGN_KEY", exportPriv)
+
+	srv := &server{
+		store: ev,
+		cfg:   Config{NodeID: "node-1", Department: "Honolulu PD", Agency: "Honolulu PD", Seal: "HPD-2026"},
+		dir:   dir,
+		key:   intKey(),
+	}
+	return srv, nodePub, exportPub
+}
+
+func postExport(t *testing.T, srv *server, body string) *httptest.ResponseRecorder {
+	t.Helper()
+	r := httptest.NewRequest(http.MethodPost, "/api/export", strings.NewReader(body))
+	w := httptest.NewRecorder()
+	srv.handleExport(w, r)
+	return w
+}
+
+func exportData(t *testing.T, w *httptest.ResponseRecorder) map[string]any {
+	t.Helper()
+	if w.Code != http.StatusOK {
+		t.Fatalf("expected 200, got %d: %s", w.Code, w.Body.String())
+	}
+	var envelope struct {
+		OK   bool           `json:"ok"`
+		Data map[string]any `json:"data"`
+	}
+	if err := json.Unmarshal(w.Body.Bytes(), &envelope); err != nil {
+		t.Fatalf("decode response: %v", err)
+	}
+	if !envelope.OK {
+		t.Fatalf("response not ok: %s", w.Body.String())
+	}
+	return envelope.Data
+}
+
+func exportedHeader(t *testing.T, path string) map[string]any {
+	t.Helper()
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	line := strings.SplitN(string(raw), "\n", 2)[0]
+	var header map[string]any
+	if err := json.Unmarshal([]byte(line), &header); err != nil {
+		t.Fatalf("decode bundle header: %v", err)
+	}
+	return header
+}
+
+func TestExportDefaultsToWitnessBundleV2(t *testing.T) {
+	srv, nodePub, exportPub := newExportServer(t)
+	data := exportData(t, postExport(t, srv, `{"case_number":"C-1"}`))
+
+	if data["format"] != "witness-bundle/2" || data["entry_count"] != float64(2) {
+		t.Fatalf("unexpected export summary: %v", data)
+	}
+	header := exportedHeader(t, data["path"].(string))
+	if header["format"] != "witness-bundle/2" {
+		t.Fatalf("format = %v", header["format"])
+	}
+	if header["entry_count"] != float64(2) {
+		t.Fatalf("entry_count = %v", header["entry_count"])
+	}
+	head := header["log_head"].(map[string]any)
+	if head["size"] != float64(3) {
+		t.Fatalf("head size = %v, want the whole log", head["size"])
+	}
+	if header["signed_by"] != exportPub {
+		t.Fatalf("signed_by = %v, want %s", header["signed_by"], exportPub)
+	}
+	if head["signer_key"] != nodePub {
+		t.Fatalf("signer_key = %v, want %s", head["signer_key"], nodePub)
+	}
+	if proofs, ok := header["proofs"].([]any); !ok || len(proofs) != 2 {
+		t.Fatalf("proofs = %v", header["proofs"])
+	}
+}
+
+func TestExportFormatOneKeepsTheLegacyPath(t *testing.T) {
+	srv, _, _ := newExportServer(t)
+	data := exportData(t, postExport(t, srv, `{"case_number":"C-1","format":1}`))
+
+	header := exportedHeader(t, data["path"].(string))
+	if _, present := header["format"]; present {
+		t.Fatalf("legacy bundle carries a format marker: %v", header["format"])
+	}
+	if header["entry_count"] != float64(2) {
+		t.Fatalf("entry_count = %v", header["entry_count"])
+	}
+}
+
+func TestExportRejectsAnUnknownFormat(t *testing.T) {
+	srv, _, _ := newExportServer(t)
+	w := postExport(t, srv, `{"case_number":"C-1","format":3}`)
+	if w.Code != http.StatusBadRequest {
+		t.Fatalf("expected 400, got %d: %s", w.Code, w.Body.String())
+	}
+}
+
+func TestExportedFileLandsUnderExports(t *testing.T) {
+	srv, _, _ := newExportServer(t)
+	data := exportData(t, postExport(t, srv, `{"case_number":"C-1"}`))
+	path := data["path"].(string)
+	if filepath.Dir(path) != filepath.Join(srv.dir, "exports") {
+		t.Fatalf("bundle path = %s", path)
+	}
+}

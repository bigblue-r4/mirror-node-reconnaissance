+func TestTheTreeAgreesWithFullLogVectors(t *testing.T) {
+	// The producer's own tree — the split point, the sibling order, the leaf
+	// preimage — rebuilt over the entry lines of vectors written by other
+	// implementations, for the two log-scope fixtures whose whole log is in the
+	// file. Same root, and every path identical hash for hash: order is
+	// load-bearing, so a path is compared element by element rather than by
+	// length or by whether the fold happens to succeed.
+	cases := []struct {
+		name string
+		pins []string
+	}{
+		{"v2-log", []string{"v2-log.export.pub", "v2-log.node.pub"}},
+		{"v2-seven", []string{"v2-seven.export.pub", "v2-seven.node.pub"}},
+		{"v2-rust-log", []string{"v2-rust.export.pub", "v2-rust.node.pub"}},
+	}
+
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			lines, err := splitLines(loadVector(t, c.name))
+			if err != nil {
+				t.Fatal(err)
+			}
+			want := mustVerify(t, c.name, loadPins(t, c.pins...)...)
+
+			leaves := make([][32]byte, len(lines)-1)
+			for i, line := range lines[1:] {
+				leaves[i] = hashLeaf(line)
+			}
+			built := newTree(leaves)
+			if got, expected := built.rootHash(), want.root; got != expected {
+				t.Fatalf("root %x, vector says %x", got, expected)
+			}
+			for i, seq := range want.seqs {
+				got := built.prove(int(seq - 1))
+				if len(got) != len(want.paths[i]) {
+					t.Fatalf("seq %d: %d hashes, vector says %d", seq, len(got), len(want.paths[i]))
+				}
+				for j := range got {
+					if got[j] != want.paths[i][j] {
+						t.Fatalf("seq %d: hash %d is %x, vector says %x",
+							seq, j, got[j], want.paths[i][j])
+					}
+				}
+			}
+		})
+	}
+}

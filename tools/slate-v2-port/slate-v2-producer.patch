diff --git a/internal/bundle/bundle.go b/internal/bundle/bundle.go
new file mode 100644
index 0000000..cc47950
--- /dev/null
+++ b/internal/bundle/bundle.go
@@ -0,0 +1,402 @@
+// Package bundle writes witness-bundle/2 court exports.
+//
+// The format is specified in mirror-node-reconnaissance's BUNDLE_SCHEMA.md §4:
+// a header whose Ed25519 signature covers a fixed line-oriented preimage, a copy
+// of the node's signed tree head, and one BLAKE3 Merkle inclusion proof per
+// disclosed entry. This package is the producer only; verification is done by an
+// independent implementation, not by the code that wrote the file.
+//
+// Two keys are involved. The node's identity key signs the tree head over
+// `size_be8 || root`; the exporter's key signs the header. They may be the same
+// key, and callers commonly use the node key for both when no separate export
+// key is configured — the format never lets a verifier assume they are equal.
+//
+// The head is minted here, at export time, from the log the caller passes in. It
+// therefore says "this node signed a tree of this size and root now"; it does not
+// say the log was complete, and a node that exports a truncated log produces a
+// smaller bundle that still verifies.
+package bundle
+
+import (
+	"bytes"
+	"crypto/ed25519"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/bigblue-r4/slate/internal/store"
+)
+
+// Format is the value of the header's format field and the first line of the
+// signed preimage.
+const Format = "witness-bundle/2"
+
+// Scope says which entries a bundle discloses.
+type Scope string
+
+const (
+	// ScopeCase discloses entries whose data.case_number matches.
+	ScopeCase Scope = "case"
+	// ScopeLog discloses every entry in the log.
+	ScopeLog Scope = "log"
+)
+
+// Request is everything the caller supplies for one export.
+type Request struct {
+	Entries     []store.Entry
+	Scope       Scope
+	CaseNumber  string
+	Department  string
+	Agency      string
+	Seal        string
+	NodeID      string
+	Actor       string // export_actor, inside the signature
+	Role        string // export_role, inside the signature
+	BundleID    string // generated when empty
+	GeneratedAt time.Time
+}
+
+// LogHead is the node's signed statement about the tree it kept.
+type LogHead struct {
+	Size      uint64 `json:"size"`
+	Root      string `json:"root"`
+	TS        string `json:"ts"`
+	Sig       string `json:"sig"`
+	SignerKey string `json:"signer_key"`
+}
+
+// Proof is one entry's Merkle inclusion proof.
+type Proof struct {
+	Seq   uint64   `json:"seq"`
+	Index uint64   `json:"index"` // seq - 1
+	Size  uint64   `json:"size"`  // log_head.size
+	Path  []string `json:"path"`  // hex, leaf-first
+}
+
+// Bundle is an encoded witness-bundle/2 document.
+type Bundle struct {
+	Format      string  `json:"format"`
+	BundleID    string  `json:"bundle_id"`
+	GeneratedAt string  `json:"generated_at"`
+	Scope       string  `json:"scope"`
+	CaseNumber  string  `json:"case_number"`
+	Department  string  `json:"department"`
+	Agency      string  `json:"agency"`
+	Seal        string  `json:"seal"`
+	NodeID      string  `json:"node_id"`
+	EntryCount  int     `json:"entry_count"`
+	SHA256Chain string  `json:"sha256_chain"`
+	ExportActor string  `json:"export_actor"`
+	ExportRole  string  `json:"export_role"`
+	SignedBy    string  `json:"signed_by"`
+	LogHead     LogHead `json:"log_head"`
+	Proofs      []Proof `json:"proofs"`
+	Signature   string  `json:"signature"`
+
+	// entries holds the disclosed lines exactly as they are written out and
+	// hashed into the tree. It is unexported so the header encoding can never
+	// include them, which is what keeps the signature independent of entry count.
+	entries [][]byte
+}
+
+// Export builds and signs a bundle.
+//
+// nodeKey signs the tree head; exportKey signs the header. Both must be Ed25519
+// private keys (64 bytes). Entry lines are json.Marshal of the store entry, the
+// same bytes the store hashed when it chained them, and are never reformatted
+// afterwards.
+func Export(req Request, nodeKey, exportKey ed25519.PrivateKey) (*Bundle, error) {
+	if len(nodeKey) != ed25519.PrivateKeySize {
+		return nil, fmt.Errorf("node key must be %d bytes", ed25519.PrivateKeySize)
+	}
+	if len(exportKey) != ed25519.PrivateKeySize {
+		return nil, fmt.Errorf("export key must be %d bytes", ed25519.PrivateKeySize)
+	}
+	if req.Scope != ScopeCase && req.Scope != ScopeLog {
+		return nil, fmt.Errorf("scope must be %q or %q", ScopeCase, ScopeLog)
+	}
+	if req.Scope == ScopeCase && req.CaseNumber == "" {
+		return nil, fmt.Errorf("scope=case requires a non-empty case number")
+	}
+	if req.Scope == ScopeLog && req.CaseNumber != "" {
+		return nil, fmt.Errorf("scope=log requires an empty case number")
+	}
+	if req.GeneratedAt.IsZero() {
+		req.GeneratedAt = time.Now().UTC()
+	}
+	if req.BundleID == "" {
+		id, err := newBundleID()
+		if err != nil {
+			return nil, err
+		}
+		req.BundleID = id
+	}
+
+	generatedAt := req.GeneratedAt.UTC().Format(time.RFC3339)
+	fields := []struct {
+		name  string
+		value string
+	}{
+		{"bundle_id", req.BundleID},
+		{"generated_at", generatedAt},
+		{"case_number", req.CaseNumber},
+		{"department", req.Department},
+		{"agency", req.Agency},
+		{"seal", req.Seal},
+		{"node_id", req.NodeID},
+		{"export_actor", req.Actor},
+		{"export_role", req.Role},
+	}
+	for _, field := range fields {
+		if err := checkField(field.name, field.value); err != nil {
+			return nil, err
+		}
+	}
+	for _, field := range []struct {
+		name  string
+		value string
+	}{
+		{"bundle_id", req.BundleID},
+		{"generated_at", generatedAt},
+		{"department", req.Department},
+		{"node_id", req.NodeID},
+	} {
+		if field.value == "" {
+			return nil, fmt.Errorf("header field %s is required", field.name)
+		}
+	}
+
+	lines := make([][]byte, len(req.Entries))
+	leaves := make([][32]byte, len(req.Entries))
+	for i, entry := range req.Entries {
+		if entry.Seq != uint64(i+1) {
+			return nil, fmt.Errorf("entry %d has seq %d; a log is numbered 1..=n with no gaps",
+				i+1, entry.Seq)
+		}
+		line, err := json.Marshal(entry)
+		if err != nil {
+			return nil, fmt.Errorf("marshal entry %d: %w", entry.Seq, err)
+		}
+		lines[i] = line
+		leaves[i] = hashLeaf(line)
+	}
+
+	tree := newTree(leaves)
+	headRoot := tree.rootHash()
+	headSize := uint64(tree.size())
+
+	selected := make([]int, 0, len(req.Entries))
+	for i, entry := range req.Entries {
+		if req.Scope == ScopeLog || entryMatchesCase(entry, req.CaseNumber) {
+			selected = append(selected, i)
+		}
+	}
+
+	chain := sha256.New()
+	for _, index := range selected {
+		_, _ = chain.Write(lines[index])
+	}
+
+	proofs := make([]Proof, 0, len(selected))
+	for _, index := range selected {
+		path := tree.prove(index)
+		hexPath := make([]string, len(path))
+		for i, node := range path {
+			hexPath[i] = hex.EncodeToString(node[:])
+		}
+		proofs = append(proofs, Proof{
+			Seq:   req.Entries[index].Seq,
+			Index: req.Entries[index].Seq - 1,
+			Size:  headSize,
+			Path:  hexPath,
+		})
+	}
+
+	var headInput [40]byte
+	binary.BigEndian.PutUint64(headInput[:8], headSize)
+	copy(headInput[8:], headRoot[:])
+	headSig := ed25519.Sign(nodeKey, headInput[:])
+
+	b := &Bundle{
+		Format:      Format,
+		BundleID:    req.BundleID,
+		GeneratedAt: generatedAt,
+		Scope:       string(req.Scope),
+		CaseNumber:  req.CaseNumber,
+		Department:  req.Department,
+		Agency:      req.Agency,
+		Seal:        req.Seal,
+		NodeID:      req.NodeID,
+		EntryCount:  len(selected),
+		SHA256Chain: hex.EncodeToString(chain.Sum(nil)),
+		ExportActor: req.Actor,
+		ExportRole:  req.Role,
+		SignedBy:    hex.EncodeToString(exportKey.Public().(ed25519.PublicKey)),
+		LogHead: LogHead{
+			Size:      headSize,
+			Root:      hex.EncodeToString(headRoot[:]),
+			TS:        generatedAt,
+			Sig:       hex.EncodeToString(headSig),
+			SignerKey: hex.EncodeToString(nodeKey.Public().(ed25519.PublicKey)),
+		},
+		Proofs:  proofs,
+		entries: make([][]byte, 0, len(selected)),
+	}
+	for _, index := range selected {
+		b.entries = append(b.entries, lines[index])
+	}
+
+	preimage, err := Preimage(b)
+	if err != nil {
+		return nil, err
+	}
+	b.Signature = hex.EncodeToString(ed25519.Sign(exportKey, preimage))
+	return b, nil
+}
+
+// Bytes encodes the bundle: the header line, then each disclosed entry line.
+func (b *Bundle) Bytes() ([]byte, error) {
+	header, err := json.Marshal(b)
+	if err != nil {
+		return nil, err
+	}
+	var buf bytes.Buffer
+	buf.Write(header)
+	buf.WriteByte('\n')
+	for _, line := range b.entries {
+		buf.Write(line)
+		buf.WriteByte('\n')
+	}
+	return buf.Bytes(), nil
+}
+
+// WriteNDJSON writes the bundle to path, creating parent directories. It refuses
+// to replace an existing file: an issued bundle is evidence.
+func (b *Bundle) WriteNDJSON(path string) error {
+	data, err := b.Bytes()
+	if err != nil {
+		return err
+	}
+	if err := os.MkdirAll(filepath.Dir(path), 0700); err != nil {
+		return err
+	}
+	f, err := os.OpenFile(path, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		return err
+	}
+	if _, err := f.Write(data); err != nil {
+		_ = f.Close()
+		return err
+	}
+	if err := f.Sync(); err != nil {
+		_ = f.Close()
+		return err
+	}
+	return f.Close()
+}
+
+// Preimage returns the bytes the bundle signature covers: BUNDLE_SCHEMA.md §4.3,
+// in order, with an empty optional field still emitted as key=.
+func Preimage(b *Bundle) ([]byte, error) {
+	var out strings.Builder
+	out.WriteString(Format)
+	out.WriteByte('\n')
+	for _, field := range []string{
+		"bundle_id", "generated_at", "scope", "case_number", "department",
+		"agency", "seal", "node_id", "entry_count", "sha256_chain",
+		"export_actor", "export_role", "signed_by",
+	} {
+		var value string
+		switch field {
+		case "bundle_id":
+			value = b.BundleID
+		case "generated_at":
+			value = b.GeneratedAt
+		case "scope":
+			value = b.Scope
+		case "case_number":
+			value = b.CaseNumber
+		case "department":
+			value = b.Department
+		case "agency":
+			value = b.Agency
+		case "seal":
+			value = b.Seal
+		case "node_id":
+			value = b.NodeID
+		case "entry_count":
+			value = fmt.Sprintf("%d", b.EntryCount)
+		case "sha256_chain":
+			value = b.SHA256Chain
+		case "export_actor":
+			value = b.ExportActor
+		case "export_role":
+			value = b.ExportRole
+		case "signed_by":
+			value = b.SignedBy
+		}
+		if err := checkField(field, value); err != nil {
+			return nil, err
+		}
+		out.WriteString(field)
+		out.WriteByte('=')
+		out.WriteString(value)
+		out.WriteByte('\n')
+	}
+	out.WriteString("log_head.size=")
+	out.WriteString(strconv.FormatUint(b.LogHead.Size, 10))
+	out.WriteByte('\n')
+	for _, field := range []struct {
+		name  string
+		value string
+	}{
+		{"log_head.root", b.LogHead.Root},
+		{"log_head.ts", b.LogHead.TS},
+		{"log_head.signer_key", b.LogHead.SignerKey},
+	} {
+		if err := checkField(field.name, field.value); err != nil {
+			return nil, err
+		}
+		out.WriteString(field.name)
+		out.WriteByte('=')
+		out.WriteString(field.value)
+		out.WriteByte('\n')
+	}
+	return []byte(out.String()), nil
+}
+
+func checkField(name, value string) error {
+	if strings.ContainsAny(value, "\r\n") {
+		return fmt.Errorf("header field %s contains a line break; the signed preimage is line-oriented", name)
+	}
+	return nil
+}
+
+func entryMatchesCase(entry store.Entry, caseNumber string) bool {
+	if len(entry.Data) == 0 {
+		return false
+	}
+	var payload struct {
+		CaseNumber string `json:"case_number"`
+	}
+	if err := json.Unmarshal(entry.Data, &payload); err != nil {
+		return false
+	}
+	return payload.CaseNumber == caseNumber
+}
+
+func newBundleID() (string, error) {
+	var suffix [4]byte
+	if _, err := rand.Read(suffix[:]); err != nil {
+		return "", fmt.Errorf("bundle id: %w", err)
+	}
+	return fmt.Sprintf("BUNDLE-%s-%s", time.Now().UTC().Format("20060102"), hex.EncodeToString(suffix[:])), nil
+}
